# ============================================================
#  Atur Perjalanan — mobile (Expo) environment template
#  Copy to mobile/.env.local. EXPO_PUBLIC_* are inlined by Metro
#  at build time. Never commit the copied file.
# ============================================================

# ── Backend API ──────────────────────────────────────────────
EXPO_PUBLIC_API_URL=

# ── Supabase Realtime ────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# ── Google Sign-In ───────────────────────────────────────────
# Web OAuth client ID (web redirect flow only).
# Native iOS/Android client IDs are configured in app.json, not here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Web origin (OAuth redirect target) — MUST be an Authorized redirect URI in Google Cloud.
# Google rejects non-loopback http origins, so use localhost for local dev (not a LAN IP).
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:8081
