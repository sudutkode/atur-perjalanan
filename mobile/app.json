{
  "expo": {
    "owner": "kizaruxd",
    "name": "Atur Perjalanan",
    "slug": "atur-perjalanan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "aturperjalanan",
      "com.googleusercontent.apps.463752801012-d0f7hsgg7f23ft4bacgeki81o5rnr2vf"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "id.kizaruxd.aturperjalanan"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B6B"
      },
      "package": "id.kizaruxd.aturperjalanan"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.463752801012-d0f7hsgg7f23ft4bacgeki81o5rnr2vf"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B6B"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 156,
          "resizeMode": "contain",
          "backgroundColor": "#FF6B6B"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e10a5810-69ea-4402-9bce-772245b09a6c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e10a5810-69ea-4402-9bce-772245b09a6c"
    }
  }
}
