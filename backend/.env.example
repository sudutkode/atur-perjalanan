# ============================================================
#  Atur Perjalanan — backend environment template
#  Copy to backend/.env. Never commit the copied file.
# ============================================================

# ── Database (Supabase PostgreSQL) ───────────────────────────
# Runtime uses the connection pooler (:6543); `prisma migrate` uses the direct URL (:5432).
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
DIRECT_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Auth & app ───────────────────────────────────────────────
# Generate JWT_SECRET and CRON_SECRET with: openssl rand -hex 32
JWT_SECRET=your-random-256-bit-secret
# Sent as `x-cron-secret` to POST /v1/cron/reminders (external hourly cron).
CRON_SECRET=your-cron-secret
# Free-tier gate: max active users (existing users can still log in).
USER_LIMIT=50
APP_ENV=development
PORT=8080
APP_WEB_URL=http://localhost:8081
# Public URL of the deployed backend — used for the Google Calendar OAuth redirect.
BACKEND_URL=

# ── Google ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Calendar OAuth client (offline access, scope .../auth/calendar.events).
# Register redirect URI: <BACKEND_URL>/v1/integrations/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=your-calendar-oauth-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-calendar-oauth-client-secret

# ── Cloudflare R2 (media storage) ────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-api-token-access-key
R2_SECRET_ACCESS_KEY=your-r2-api-token-secret
R2_BUCKET_NAME=atur-perjalanan-media
# Optional — internal DB reference only; clients receive presigned GET URLs.
# Web uploads also need bucket CORS — see docs/DEPLOYMENT.md §2.3.
R2_PUBLIC_URL=https://your-r2-custom-domain.example.com

# ── Email (SMTP) ─────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email; invitations stay pending in the DB.
SMTP_HOST=your-smtp-host.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=Atur Perjalanan <noreply@atur-perjalanan.app>

# ── Expo push notifications ──────────────────────────────────
# From expo.dev/settings/access-tokens; empty skips push (in-app only).
EXPO_ACCESS_TOKEN=your-expo-access-token
